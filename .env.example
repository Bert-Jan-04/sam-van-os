# --- Database ---
# PostgreSQL connection string used by @payloadcms/db-postgres
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/sam-van-os-coaching

# --- Payload ---
# Random string used to encrypt/sign Payload data (JWT, cookies, etc). Generate a strong secret,
# e.g. `openssl rand -base64 32`. Never reuse this value across environments.
PAYLOAD_SECRET=

# --- Next.js ---
# Public base URL of the site, used for absolute URLs (SEO, Open Graph images, sitemaps, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage ---
# Vercel Blob read/write token for media uploads (@payloadcms/storage-vercel-blob).
# Leave unset locally: uploads then fall back to local disk storage (./media).
# In Vercel, this is set automatically once you connect a Blob store to the project.
# BLOB_READ_WRITE_TOKEN=

# --- Future external services (placeholders) ---
# Example: e-mail provider used for auth / contact forms
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
